{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sliverarmory/sliver-test-ext/schema/sliver-ext-e2e-v1.schema.json",
  "title": "Sliver extension end-to-end manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "sliver", "suites"],
  "properties": {
    "schema": { "const": "sliver-ext-e2e/v1" },
    "sliver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version"],
      "properties": {
        "version": {
          "type": "string",
          "anyOf": [
            { "enum": ["latest", "master"] },
            { "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
            { "pattern": "^[0-9a-fA-F]{40}$" }
          ]
        }
      }
    },
    "defaults": { "$ref": "#/$defs/settingsOnly" },
    "suites": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/suite" }
    }
  },
  "$defs": {
    "settings": {
      "type": "object",
      "properties": {
        "export": { "type": "string", "minLength": 1 },
        "init": { "type": "string" },
        "args_utf8": { "type": "string", "maxLength": 16777216 },
        "args_base64": { "type": "string" },
        "modes": { "$ref": "#/$defs/modes" },
        "repeat": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "command_timeout": { "type": "string", "minLength": 1 },
        "expect": { "$ref": "#/$defs/expect" }
      },
      "not": { "required": ["args_utf8", "args_base64"] }
    },
    "settingsOnly": {
      "allOf": [{ "$ref": "#/$defs/settings" }],
      "unevaluatedProperties": false
    },
    "modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["session", "beacon"] }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "arch"],
      "properties": {
        "os": { "enum": ["darwin", "linux", "windows"] },
        "arch": { "enum": ["386", "amd64", "arm64"] }
      },
      "oneOf": [
        { "properties": { "os": { "const": "darwin" }, "arch": { "enum": ["amd64", "arm64"] } } },
        { "properties": { "os": { "const": "linux" }, "arch": { "enum": ["386", "amd64", "arm64"] } } },
        { "properties": { "os": { "const": "windows" }, "arch": { "enum": ["386", "amd64", "arm64"] } } }
      ]
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "equals": { "type": "string" },
        "contains": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "not_contains": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "matches": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "equals_base64": { "type": "string" }
      },
      "not": { "required": ["equals", "equals_base64"] }
    },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "success_only": { "type": "boolean" },
        "output": { "$ref": "#/$defs/output" }
      },
      "oneOf": [
        { "required": ["success_only"], "properties": { "success_only": { "const": true } }, "not": { "required": ["output"] } },
        { "required": ["output"], "properties": { "success_only": { "const": false } } }
      ]
    },
    "tcpProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port", "state"],
      "properties": {
        "port": { "anyOf": [{ "type": "integer", "minimum": 1, "maximum": 65535 }, { "const": "auto" }] },
        "state": { "enum": ["open", "closed"] },
        "timeout": { "type": "string", "minLength": 1 },
        "banner_utf8": { "type": "string", "maxLength": 4096 }
      },
      "if": { "properties": { "state": { "const": "closed" } }, "required": ["state"] },
      "then": { "not": { "required": ["banner_utf8"] } }
    },
    "commandProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(/|$)).+$" },
        "args": { "type": "array", "maxItems": 32, "items": { "type": "string", "maxLength": 4096 } },
        "timeout": { "type": "string", "minLength": 1 }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "expect"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "export": { "type": "string", "minLength": 1 },
        "args_utf8": { "type": "string", "maxLength": 16777216 },
        "args_base64": { "type": "string" },
        "command_timeout": { "type": "string", "minLength": 1 },
        "expect": { "$ref": "#/$defs/expect" },
        "tcp_probe": { "$ref": "#/$defs/tcpProbe" },
        "command_probe": { "$ref": "#/$defs/commandProbe" }
      },
      "not": { "required": ["args_utf8", "args_base64"] }
    },
    "test": {
      "allOf": [
        { "$ref": "#/$defs/settings" },
        {
          "type": "object",
          "required": ["name", "library"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "library": { "type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(/|$)).*\\.(?:[dD][lL][lL]|[sS][oO]|[dD][yY][lL][iI][bB])$" },
            "steps": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/step" } }
          }
        },
        {
          "if": { "required": ["steps"] },
          "then": { "not": { "anyOf": [{ "required": ["args_utf8"] }, { "required": ["args_base64"] }, { "required": ["expect"] }] } }
        }
      ],
      "unevaluatedProperties": false
    },
    "override": { "$ref": "#/$defs/settingsOnly" },
    "collection": {
      "allOf": [
        { "$ref": "#/$defs/settings" },
        {
          "type": "object",
          "required": ["name", "glob"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "glob": { "type": "string", "minLength": 1 },
            "overrides": {
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/override" }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "target"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "target": { "$ref": "#/$defs/target" },
        "tests": { "type": "array", "items": { "$ref": "#/$defs/test" } },
        "collections": { "type": "array", "items": { "$ref": "#/$defs/collection" } }
      },
      "anyOf": [
        { "required": ["tests"], "properties": { "tests": { "minItems": 1 } } },
        { "required": ["collections"], "properties": { "collections": { "minItems": 1 } } }
      ]
    }
  }
}
